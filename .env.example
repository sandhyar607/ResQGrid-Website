# Set your Gemini API key to enable live conversational planning. Without it, the chat API uses safe, data-grounded fallback responses.
GEMINI_API_KEY=
# Current stable Gemini Flash model; override if your account uses another model.
GEMINI_MODEL=gemini-3.8-flash
# Optional override for frontends deployed separately from the API.
# VITE_CHAT_API_URL=http://localhost:5177/api/chat
